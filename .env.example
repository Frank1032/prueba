# ============================================================
# VARIABLES DE ENTORNO - COPIA ESTE ARCHIVO A ".env"
# ============================================================
# Renombra este archivo a ".env" y completa los valores
# con los datos de tu instancia Supabase (cloud o self-hosted)
# ============================================================

# URL de tu proyecto Supabase
# - Supabase Cloud: https://TU_PROJECT_ID.supabase.co
# - Self-hosted:    http://TU_IP_O_DOMINIO:8000
VITE_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co

# Clave pública (anon key) de tu proyecto Supabase
# La encuentras en: Settings → API → Project API keys → anon public
VITE_SUPABASE_PUBLISHABLE_KEY=TU_ANON_KEY_AQUI

# ============================================================
# PASOS PARA USAR EN OTRO SERVIDOR
# ============================================================
# 1. Instala Supabase self-hosted con Docker:
#    https://supabase.com/docs/guides/self-hosting/docker
#
# 2. Aplica el esquema de base de datos ejecutando las
#    migraciones ubicadas en: supabase/migrations/
#
# 3. Copia este archivo a ".env" y completa los valores
#    con los de tu nueva instancia Supabase
#
# 4. Compila el frontend:
#    npm install
#    npm run build
#
# 5. Sirve la carpeta "dist/" con Nginx, Apache, o cualquier
#    servidor web estático
# ============================================================
