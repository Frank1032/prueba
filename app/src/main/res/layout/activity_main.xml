<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="TAREA 3 · EFFICIENTNETB0 · VISIÓN MÓVIL"
            android:textColor="@color/acento"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="¿Qué animal es?"
            android:textColor="@color/tinta"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.15"
            android:text="Nuestra red reconoce araña, ardilla, gallina, gato y vaca. Funciona dentro del celular, sin internet."
            android:textColor="@color/tinta_suave"
            android:textSize="16sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/fondo_tarjeta"
            android:padding="1dp">

            <ImageView
                android:id="@+id/foto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Foto que analiza la red"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/aviso"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="Tome una foto o elija una de la galería"
                android:textColor="@color/tinta_suave"
                android:textSize="16sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/botonTomar"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/fondo_boton"
                android:text="Tomar foto"
                android:textAllCaps="false"
                android:textColor="@color/superficie"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/botonGaleria"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/fondo_boton_claro"
                android:text="Galería"
                android:textAllCaps="false"
                android:textColor="@color/acento"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/animal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="–"
                android:textColor="@color/tinta"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/confianza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="@color/acento"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/duda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/fondo_duda"
            android:padding="12dp"
            android:text="La red no está segura. Funciona mejor con un solo animal que se vea cerca y completo."
            android:textColor="@color/tinta"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/barras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/fondo_tarjeta"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tiempo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tiempo de la red en este celular: –"
                android:textColor="@color/tinta"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Tamaño de la red: 8,1 MB (pesos de 16 bits)"
                android:textColor="@color/tinta"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Acierto en fotos de prueba: 98,9 % (742 de 750)"
                android:textColor="@color/tinta"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="La red solo conoce estos cinco animales. Si le muestra otro, responde con el que más se le parezca."
            android:textColor="@color/tinta_suave"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
